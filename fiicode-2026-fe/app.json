{
  "expo": {
    "name": "fiicode-2026-fe",
    "slug": "fiicode-2026-fe",
    "version": "1.0.0",
    "scheme": "fiicode-2026-fe",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.georgedenis08.fiicode-2026-fe"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.georgedenis08.fiicode2026fe"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0c3fb04-db41-4074-993b-dc2ad4e12d7b"
      }
    },
    "owner": "georgedenis08",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f0c3fb04-db41-4074-993b-dc2ad4e12d7b"
    }
  }
}
